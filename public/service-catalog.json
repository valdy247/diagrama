{
  "schemaVersion": "1.0.0",
  "brand": "VMV Business",
  "scope": "Public module registry for frontend integration planning; not an authenticated service API",
  "auth": {
    "futureProvider": "Supabase Auth",
    "identity": "shared_auth_subject",
    "businessContext": "business_id",
    "sessionRule": "verified on server; never trust client claims"
